# Server Configuration
PORT=5001

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loopera
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration (use a long random secret in production; never commit real values)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=12h
JWT_REFRESH_MAX_AGE_DAYS=7

# Optional one-time staff bootstrap (omit in normal runs; rotate after use)
# SEED_MANAGER_PASSWORD=
# SEED_ADMIN_PASSWORD=

# DB pool
DB_POOL_MAX=20

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email — Resend (recommended, free tier)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@loopera.ru
EMAIL_FROM_NAME=Loopera
OPS_EMAIL=triphoyloops@gmail.com
PARTNERS_EMAIL=triphoyloops@gmail.com
SUPPORT_EMAIL=support@loopera.ru

# Legacy SMTP fallback (Gmail / Zoho) if RESEND_API_KEY is empty
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_USER=
# EMAIL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://loopera.ru/api/auth/google/callback

# Environment
NODE_ENV=development

# Melody generation (Python FastAPI service, local MVP)
MELODY_SERVICE_URL=http://localhost:8001

# Admin IP Whitelist (comma-separated IPs allowed to access admin functions)
ADMIN_IPS=127.0.0.1,::1

# YooKassa (payments)
YOOKASSA_SHOP_ID=1391181
YOOKASSA_SECRET_KEY=your_yookassa_secret_key

# Redis (shared rate-limit across replicas). Leave empty → in-memory store.
# REDIS_URL=redis://127.0.0.1:6379

# Object storage (S3 / Cloudflare R2 / MinIO). Leave empty → local uploads/ disk.
# S3_BUCKET=loopera-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# MEDIA_CDN_URL=https://cdn.loopera.ru
# STORAGE_DELETE_LOCAL=false
