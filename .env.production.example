NODE_ENV=production
PORT=5001

# Public domain (Caddy TLS)
DOMAIN=loopera.ru
ACME_EMAIL=ops@loopera.ru
FRONTEND_URL=https://loopera.ru

DB_HOST=postgres
DB_PORT=5432
DB_NAME=loopera
DB_USER=loopera
DB_PASSWORD=GENERATE_STRONG_PASSWORD
DB_POOL_MAX=20

# openssl rand -hex 48
JWT_SECRET=GENERATE_STRONG_SECRET_MIN_48_CHARS
JWT_EXPIRES_IN=12h
JWT_REFRESH_MAX_AGE_DAYS=7

# Email (prefer Resend + verified domain)
RESEND_API_KEY=
EMAIL_FROM=noreply@loopera.ru
OPS_EMAIL=
SUPPORT_EMAIL=support@loopera.ru
# SMTP fallback (optional):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://loopera.ru/api/auth/google/callback

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

MELODY_SERVICE_URL=http://melody:8001
REDIS_URL=redis://redis:6379

# Crash reporting (optional)
# SENTRY_DSN=https://KEY@oXXXX.ingest.sentry.io/PROJECT
# VITE_SENTRY_DSN=https://KEY@oXXXX.ingest.sentry.io/PROJECT

# Same-origin frontend build (leave empty in prod behind Caddy)
VITE_API_URL=
# VITE_MEDIA_CDN_URL=https://cdn.loopera.ru

# Object storage (Cloudflare R2 / S3) — strongly recommended before traffic
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://XXXX.r2.cloudflarestorage.com
# MEDIA_CDN_URL=https://cdn.loopera.ru
# STORAGE_DELETE_LOCAL=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=db-backups

# First-boot only — unset after accounts exist
# SEED_MANAGER_PASSWORD=
# SEED_ADMIN_PASSWORD=

# PgAdmin profile only: docker compose --profile admin up -d
# PGADMIN_EMAIL=admin@loopera.ru
# PGADMIN_PASSWORD=
